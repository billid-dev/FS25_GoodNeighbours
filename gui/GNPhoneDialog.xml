<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<!-- Good Neighbours - phone (author: billiD) -->
<GUI onOpen="onOpen" onClose="onClose">
    <GuiElement profile="newLayer"/>
    <Bitmap profile="dialogFullscreenBg"/>

    <GuiElement profile="gn_phone" id="dialogElement">
        <!-- wallpaper under the frame: the frame's transparent screen shows it with rounded corners -->
        <Bitmap profile="gn_wallpaper_deere" id="wallpaper_deere" visible="false"/>
        <Bitmap profile="gn_wallpaper_claas" id="wallpaper_claas" visible="false"/>
        <Bitmap profile="gn_wallpaper_silage" id="wallpaper_silage" visible="false"/>
        <Bitmap profile="gn_wallpaper_krone" id="wallpaper_krone" visible="false"/>
        <Bitmap profile="gn_shade" id="shadeElement"/>
        <Bitmap profile="gn_frame"/>

        <GuiElement profile="gn_screen" id="screenElement">
            <Bitmap profile="gn_portrait_1" id="portrait1" visible="false"/>
            <Bitmap profile="gn_portrait_2" id="portrait2" visible="false"/>
            <Bitmap profile="gn_portrait_3" id="portrait3" visible="false"/>
            <Bitmap profile="gn_portrait_4" id="portrait4" visible="false"/>
            <Bitmap profile="gn_portrait_5" id="portrait5" visible="false"/>
            <Bitmap profile="gn_portrait_6" id="portrait6" visible="false"/>
            <Bitmap profile="gn_portrait_7" id="portrait7" visible="false"/>

            <!-- screens without a photo -->
            <Text profile="gn_titleTop" id="titleTop" text=""/>
            <Text profile="gn_bodyTop" id="bodyTop" text=""/>
            <!-- screens with a photo -->
            <Text profile="gn_titleLow" id="titleLow" text="" visible="false"/>
            <Text profile="gn_bodyLow" id="bodyLow" text="" visible="false"/>

            <!-- settings app -->
            <Button profile="gn_rowWallpaper" id="wallpaperButton" text="" onClick="onClickWallpaper" visible="false"/>
            <Button profile="gn_rowVolume" id="volumeButton" text="" onClick="onClickVolume" visible="false"/>
            <Button profile="gn_rowMute" id="muteButton" text="" onClick="onClickMute" visible="false"/>
            <Button profile="gn_rowSms" id="smsButton" text="" onClick="onClickSms" visible="false"/>
            <Button profile="gn_pillRead" id="readButton" text="-" onClick="onClickRead" visible="false"/>
            <Button profile="gn_pillAirplane" id="airplaneButton" text="-" onClick="onClickAirplane" visible="false"/>
            <Text profile="gn_adminTitle" id="adminTitle" text="" visible="false"/>
            <Button profile="gn_pillCalls" id="callsButton" text="-" onClick="onClickCallsPerDay" visible="false"/>
            <Button profile="gn_pillFields" id="fieldsButton" text="-" onClick="onClickFieldsPerCall" visible="false"/>
            <Button profile="gn_pillWork" id="workButton" text="-" onClick="onClickNpcWork" visible="false"/>

            <!-- call -->
            <Button profile="gn_bigLeftAnswer" id="answerButton" text="" onClick="onClickAnswer" visible="false"/>
            <Button profile="gn_bigLeftAccept" id="acceptButton" text="" onClick="onClickAccept" visible="false"/>
            <Button profile="gn_bigCenterBorrow" id="borrowButton" text="" onClick="onClickBorrow" visible="false"/>
            <Button profile="gn_bigRightDecline" id="declineButton" text="" onClick="onClickDecline" visible="false"/>
            <Text profile="gn_labelLeft" id="labelLeft" text="" visible="false"/>
            <Text profile="gn_labelCenter" id="labelCenter" text="" visible="false"/>
            <Text profile="gn_labelRight" id="labelRight" text="" visible="false"/>

            <Button profile="gn_pillParking" id="parkingButton" text="-" onClick="onClickParkingHere" visible="false"/>
            <Button profile="gn_pillOutfit" id="outfitButton" text="-" onClick="onClickOutfit" visible="false"/>
            <Button profile="gn_pillHome" id="homeButton" text="-" onClick="onClickHomeHere" visible="false"/>

            <!-- bottom bar -->
            <Button profile="gn_barLeftContacts" id="contactsButton" text="" onClick="onClickContacts" visible="false"/>
            <Button profile="gn_barLeftBack" id="backButton" text="" onClick="onClickBackButton" visible="false"/>
            <Button profile="gn_barCenterClose" id="closeButton" text="" onClick="onClickClose" visible="false"/>
            <Button profile="gn_barRightSettings" id="settingsButton" text="" onClick="onClickSettings" visible="false"/>
            <Button profile="gn_barMidLeftPrev" id="prevButton" text="" onClick="onClickPrev" visible="false"/>
            <Button profile="gn_barMidRightNext" id="nextButton" text="" onClick="onClickNext" visible="false"/>
        </GuiElement>
    </GuiElement>

    <GUIProfiles>
        <Profile name="gn_phone" extends="baseReference" with="pivotMiddleCenter">
            <size value="420px 800px"/>
            <alignmentX value="center"/>
            <alignmentY value="center"/>
            <imageColor value="0 0 0 0"/>
            <color value="0 0 0 0"/>
        </Profile>
        <Profile name="gn_wallpaper" extends="baseReference" with="anchorMiddleCenter pivotMiddleCenter">
            <size value="384px 764px"/>
            <imageColor value="1 1 1 1"/>
        </Profile>
        <Profile name="gn_wallpaper_deere" extends="gn_wallpaper" with="anchorMiddleCenter pivotMiddleCenter">
            <imageSliceId value="gnWp_deere.img"/>
        </Profile>
        <Profile name="gn_wallpaper_claas" extends="gn_wallpaper" with="anchorMiddleCenter pivotMiddleCenter">
            <imageSliceId value="gnWp_claas.img"/>
        </Profile>
        <Profile name="gn_wallpaper_silage" extends="gn_wallpaper" with="anchorMiddleCenter pivotMiddleCenter">
            <imageSliceId value="gnWp_silage.img"/>
        </Profile>
        <Profile name="gn_wallpaper_krone" extends="gn_wallpaper" with="anchorMiddleCenter pivotMiddleCenter">
            <imageSliceId value="gnWp_krone.img"/>
