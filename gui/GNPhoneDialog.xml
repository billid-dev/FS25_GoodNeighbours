        <Profile name="gn_textBase" extends="baseReference" with="anchorTopStretchingX">
            <textColor value="0.96 0.97 1 1"/>
            <textAlignment value="center"/>
            <imageColor value="0 0 0 0"/>
        </Profile>
        <Profile name="gn_titleTop" extends="gn_textBase" with="anchorTopStretchingX">
            <size value="100% 32px"/>
            <position value="0px -62px"/>
            <textSize value="26px"/>
            <textBold value="true"/>
            <textVerticalAlignment value="middle"/>
        </Profile>
        <Profile name="gn_titleLow" extends="gn_titleTop" with="anchorTopStretchingX">
            <position value="0px -232px"/>
