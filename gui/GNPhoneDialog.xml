        <Profile name="gn_shade" extends="baseReference" with="anchorMiddleCenter pivotMiddleCenter">
            <size value="384px 764px"/>
            <imageSliceId value="gnIcons.white"/>
            <imageColor value="0.02 0.03 0.04 0.35"/>
        </Profile>
        <Profile name="gn_frame" extends="baseReference" with="anchorStretchingYStretchingX">
            <size value="100% 100%"/>
