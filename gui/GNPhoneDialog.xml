            <position value="0px -70px"/>
            <imageColor value="1 1 1 1"/>
        </Profile>
        <Profile name="gn_portrait_1" extends="gn_portrait" with="anchorTopCenter pivotTopCenter">
            <imageSliceId value="gnPortrait_henryk_wolski.img"/>
        </Profile>
        <Profile name="gn_portrait_2" extends="gn_portrait" with="anchorTopCenter pivotTopCenter">
            <imageSliceId value="gnPortrait_sarah_mitchell.img"/>
        </Profile>
        <Profile name="gn_portrait_3" extends="gn_portrait" with="anchorTopCenter pivotTopCenter">
