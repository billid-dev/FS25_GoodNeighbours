            <position value="0px -104px"/>
            <textSize value="16px"/>
            <textVerticalAlignment value="top"/>
            <textMaxWidth value="330px"/>
            <textMaxNumLines value="26"/>
            <textLineHeightScale value="1.25"/>
            <textColor value="0.88 0.9 0.94 1"/>
        </Profile>
        <Profile name="gn_bodyLow" extends="gn_bodyTop" with="anchorTopStretchingX">
            <size value="100% 270px"/>
